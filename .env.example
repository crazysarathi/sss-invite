# Where the PHP RSVP/admin API (sss-admin/) is deployed.
#
# Leave unset (or empty) if sss-admin/ is deployed on the SAME domain as
# this built site (e.g. a single Apache/Nginx+PHP host) — the app will use
# same-origin relative paths.
#
# Set this if the frontend is on a static host that can't run PHP
# (Vercel, Netlify, GitHub Pages, ...) and the PHP backend lives elsewhere.
# No trailing slash, no /sss-admin suffix — just the backend's origin.
#
VITE_API_BASE_URL=https://www.salemsupersmashers.com/
